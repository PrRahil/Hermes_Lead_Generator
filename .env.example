# LLM via OpenRouter (optional — hunting works without it)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4.1-nano
OPENROUTER_HTTP_REFERER=http://127.0.0.1:8787
OPENROUTER_APP_TITLE=Hermes Lead Machine

SERPER_API_KEY=
HUNTER_API_KEY=

HERMES_HOST=127.0.0.1
HERMES_PORT=8787
HERMES_DB_PATH=data/hermes_leads.db

# Continuous hunt
SCAN_INTERVAL_SEC=180
STRONG_LEAD_TARGET=50
STRONG_LEAD_MIN_SCORE=45
QUALIFY_MIN_SCORE=40
LISTING_DEAL_MIN_SCORE=40
LISTING_TTL_DAYS=21
KEEP_EXPIRED_DAYS=7
HERMES_USE_LLM=false

# Camoufox (optional — your cookies/profile, slow pacing)
CAMOUFOX_ENABLED=false
CAMOUFOX_HEADLESS=true
CAMOUFOX_MIN_DELAY_SEC=4

# Optional SMTP for Send draft
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Light ICP
ICP_INDUSTRIES=technology,software,saas,data,artificial intelligence,machine learning,analytics,cloud,fintech,healthtech
ICP_MIN_EMPLOYEES=5
ICP_MAX_EMPLOYEES=10000
ICP_MIN_REVENUE_USD=250000
ICP_TARGET_TITLES=CTO,VP Engineering,Head of Data,Head of AI,ML Engineer,Data Engineer,Founder,CEO,Product Manager,Director of Analytics,VP Data,Chief Data Officer,MLOps Lead
ICP_KEYWORDS=data pipeline,data engineering,LLM,RAG,machine learning,AI agent,MLOps,analytics platform,feature store,vector database,ETL,ELT,dbt,Snowflake,BigQuery,Databricks,Kafka,real-time analytics,AI consultant,generative AI,LLM evaluation,prompt engineering,embeddings,recommendation system,NLP,computer vision,data warehouse,business intelligence,Looker,Power BI,Airflow,orchestration